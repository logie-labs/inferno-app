# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the one that documents the settings and holds no values. A clone
# with no example has to read the SPEC to learn what is configurable.
!**/.env.example

# typescript
*.tsbuildinfo
next-env.d.ts

# design-sync
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
.design-sync/styles/

# inferno-service
# The Python source is versioned. Its own service/.gitignore already excludes
# the virtualenv, the PyInstaller output and the large, platform-specific
# vendored binaries - see service/vendor/README.md for how to restore those.
service/inferno-settings.json

# Anything the app has actually downloaded. Never publishable, and easy to
# commit by accident once a dev run has filled it with media.
/downloads/

# Stray output if the service is ever launched from src-tauri.
src-tauri/downloads/

# Scratch notes, not part of the project.
next_prompt

# Per-machine agent permissions. A global ignore covers this on the machine it
# was written on; naming it here means the protection travels with the repo.
.claude/settings.local.json
