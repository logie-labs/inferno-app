# Copy to `.env` beside this file. Compose reads that; it is gitignored.
#
# Every value here maps to a row in `service/inferno_service/config.py`, which
# is the single source of truth for what exists and what it does. Anything not
# listed can still be set - find its `env=` there.
#
# One rule worth knowing before you add anything: a variable set here *pins*
# that setting. The settings screen shows it greyed out and refuses to change
# it, because the environment outranks the config file. Set only what this
# deployment genuinely has to fix, and leave the rest for the UI to own.


# --- the port on the host ---------------------------------------------------
# Inside the container the service is always on 8765. This is only the host
# side of the mapping in docker-compose.yml.
INFERNO_PORT=8765


# --- authentication ---------------------------------------------------------
# Deliberately left unset, and you need to understand why before exposing this.
#
# The service supports a shared token (`API_TOKEN`), but the browser frontend
# does not send one - `getServiceEndpoint()` in lib/inferno-service.ts returns
# an empty token outside Tauri, because on a desktop install the API is on
# localhost and the token comes from the Tauri side. Set API_TOKEN here and the
# API is protected but the UI stops working: every request it makes gets a 401.
#
# So: this image is safe on a loopback binding and unsafe anywhere else. For
# real remote access, put a reverse proxy in front and authenticate there
# (OAuth2 Proxy, Authelia, Cloudflare Access, or plain basic auth) rather than
# publishing the port. SPEC §2 lists multi-user auth as an explicit non-goal of
# the service, so this is a gap to close in front of it, not inside it.
#
# API_TOKEN=

# Which browser origins may call the API. Must be non-empty to mean anything:
# an empty value is treated as unset and falls back to the service's default of
# "*", which lets any page on the internet drive this instance from a visitor's
# browser. Since the API needs no credentials by default, that is a real hole
# rather than a theoretical one - so this is set, not blank.
#
# The UI is served from the API's own origin and so is never cross-origin;
# naming that origin here allows exactly it and nothing else. Change it to
# match whatever address people actually reach this on, and add more
# comma-separated if a different site has to call the API too.
CORS_ORIGINS=http://127.0.0.1:8765


# --- downloads --------------------------------------------------------------
# All three live on the /data volume. Change them only if you mount elsewhere.
DOWNLOAD_DIR=/data/downloads
INFERNO_CONFIG_FILE=/data/inferno-settings.json

# Where the finished queue is remembered, so it survives a restart rather than
# emptying itself on every deploy. Set empty to keep jobs in memory only, which
# is the service's own default and what the desktop app uses. Only finished
# jobs are written - an interrupted download cannot be resumed from a file, and
# a restored job stuck at "downloading" forever would be worse than absent.
STATE_FILE=/data/inferno-jobs.json

# Where extracted video frames are kept, so a folder of videos reads as videos
# rather than as a column of identical icons. Made once per file with ffmpeg
# and then served from here, keyed on the file's size and modification time -
# replace a file under the same name and the next request makes a new frame
# rather than serving the old picture. Empty turns thumbnails off.
THUMBNAIL_DIR=/data/thumbnails

# How many jobs run at once. Each can spawn an ffmpeg, so this multiplies both
# CPU and memory against the limit set in docker-compose.yml.
MAX_CONCURRENT=2

# Finished jobs, and their files, are dropped this many seconds after they end.
# This is the retention that outlives restarts now that STATE_FILE is set, so
# it is the one that decides how long the queue actually remembers. Default is
# 24 hours.
# JOB_TTL=86400


# --- getting past bot checks ------------------------------------------------
# The practical problem with running this in a datacenter rather than at home:
# YouTube serves "Sign in to confirm you're not a bot" to cloud IP ranges far
# more aggressively than to residential ones. If downloads fail on a VPS that
# worked on your desktop, this is why, and it is not a bug in the service.
#
# A residential or well-reputed proxy is the reliable fix.
# PROXY=http://user:pass@host:port
#
# Cookies exported from a signed-in browser help for age-gated and some
# throttled content. `COOKIES_FROM_BROWSER` cannot work in a container - there
# is no browser profile - so use a cookie file mounted into the image.
# COOKIE_FILE=/data/cookies.txt
