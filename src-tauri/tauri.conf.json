{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "inferno-app",
  "version": "0.1.0",
  "identifier": "com.inferno-app.app",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "inferno-app",
        "width": 1160,
        "height": 740,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "resources": {
      "../service/dist/inferno-service/": "service/",
      "../service/vendor/": "vendor/"
    }
  }
}
