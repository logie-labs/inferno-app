# Inferno service configuration. Every setting is optional; these are the
# defaults (SPEC section 9). Copy to .env or export them before starting.

# DOWNLOAD_DIR=./downloads
# MAX_CONCURRENT=2
# JOB_TTL=86400
# EVENT_HISTORY=250
# PROGRESS_INTERVAL=0.25
# INFO_CACHE_TTL=300

# If set, every request must carry it: X-API-Key header or ?token= query.
# API_TOKEN=

# CORS_ORIGINS=*

# Directory or binary path. Overrides the bundled vendor/ tree and PATH.
# ffprobe must sit beside ffmpeg under its plain name.
# FFMPEG_DIR=
# JS_RUNTIME_DIR=

# YouTube caps un-tokened downloads. Cookies are the usual way around it.
# COOKIES_FROM_BROWSER=firefox
# COOKIE_FILE=

# HTTP_CHUNK_SIZE=262144
# SERVE_FILES=true

# Beyond the SPEC section 9 table:
# RETRIES=10
# PROXY=
# Where settings persist. A desktop app should point this at its app-data dir.
# INFERNO_CONFIG_FILE=./inferno-settings.json
