{
  "name": "inferno-app",
  "version": "0.1.0",
  "description": "A desktop downloader for video and audio, built on yt-dlp.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/logie-labs/inferno-app.git"
  },
  "bugs": {
    "url": "https://github.com/logie-labs/inferno-app/issues"
  },
  "homepage": "https://github.com/logie-labs/inferno-app",
  "type": "module",
  "private": true,
  "scripts": {
    "dev:web": "next dev --turbopack --port 3000",
    "dev:tauri": "node scripts/ensure-service-dir.mjs && tauri dev",
    "dev": "npm run dev:tauri",
    "build": "next build",
    "build:cloud": "node scripts/build-cloud.mjs",
    "docker:build": "docker build -f docker/Dockerfile -t inferno-server .",
    "docker:up": "docker compose -f docker/docker-compose.yml up --build",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "tauri:build": "npm run build:service && tauri build",
    "build:service": "node scripts/build-service.mjs",
    "build:bundle": "npm run build:service && npm run build",
    "ensure:service-dir": "node scripts/ensure-service-dir.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@remixicon/react": "^4.9.0",
    "@tauri-apps/api": "^2.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "country-flag-icons": "^1.6.20",
    "date-fns": "^4.4.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "react-resizable-panels": "^4.12.3",
    "shadcn": "^4.19.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
